# Copy to .env.local for local development: cp .env.example .env.local
# Next.js and bun both read .env.local. Never commit it (.gitignore covers it).
# Everything is optional except an AI key: without one, pages work but drafting,
# Virgil, page builds and covers fail.

# ---- AI provider ----------------------------------------------------------------
# xai (default) until Meta credits land; meta for the submission.
AI_PROVIDER=xai

# xAI, option 1 (recommended for the team): the shared key API. The app fetches the
# current key itself and refetches when it changes (the key rotates every 2 hours).
# Ask Java for both values.
GROK_KEY_API_URL=
GROK_KEY_API_PASSWORD=

# xAI, option 2: a fixed key. Takes priority over the key API when set.
XAI_API_KEY=

# Meta (AI_PROVIDER=meta). Set one of these:
#   META_API_KEY  a personal Meta key; calls go straight to https://api.meta.ai/v1
#   GATEWAY_KEY   Mark's team gateway (GATEWAY_JUDGES_KEY optional, used for judge traffic)
META_API_KEY=
GATEWAY_KEY=
GATEWAY_JUDGES_KEY=
# Override the Meta base URL (defaults depend on which key is set).
META_BASE_URL=

# Per-job model overrides, e.g. AI_MODEL_CODEGEN=muse-wonder-1.0
# Jobs: AGENT, DRAFT, CODEGEN, FAST, IMAGE. Defaults are in lib/server/ai/client.ts.
# AI_MODEL_AGENT=
# Log each model call's job, model, time and token usage.
# AI_DEBUG=1

# ---- App ------------------------------------------------------------------------
# Public origin, used in links, the agent guide and share images. Defaults to the
# request's own origin, so leave it empty locally.
PUBLIC_URL=
# Data folder (SQLite database, covers, generated media). Defaults to ./data.
# DATA_DIR=
# DATABASE_PATH=
# Signs session cookies. Required in production (32+ chars); dev uses a fixed one.
# SESSION_SECRET=
# Protects /api/admin/*. Required in production; open in dev when empty.
# ADMIN_KEY=

# ---- Tests and scripts ----------------------------------------------------------
# Where `bun test`, `bun run seed` and `bun run ai-check` send requests.
# BASE_URL=http://localhost:3000
