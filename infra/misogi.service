# Misogi Next.js server. Installed to /etc/systemd/system/misogi.service by infra/provision.sh.
# /srv/misogi/app is a symlink to the live release in /srv/misogi/releases/ (scripts/deploy.sh
# switches it and restarts this unit). Caddy proxies https://<host> to 127.0.0.1:3000.

[Unit]
Description=Misogi (Next.js)
After=network-online.target
Wants=network-online.target
# Before the first deploy there's no release yet: skip quietly instead of restart-looping.
ConditionPathExists=/srv/misogi/app/package.json

[Service]
Type=simple
User=misogi
Group=misogi
WorkingDirectory=/srv/misogi/app
EnvironmentFile=/etc/misogi/env
Environment=NEXT_TELEMETRY_DISABLED=1
# A stop first lets page builds, pictures and answers in progress finish (instrumentation.ts); a build can take
# five minutes, so the stop waits up to ten.
Environment=NEXT_MANUAL_SIG_HANDLE=true
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=600
# Node exits with 143 on SIGTERM; that's a clean stop, not a failure.
SuccessExitStatus=143
UMask=0027

# Hardening. Don't add MemoryDenyWriteExecute: it breaks the V8 JIT.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/misogi
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
