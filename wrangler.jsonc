{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meta-hackathon",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"previews": {}
}
